# Databricks SQL warehouse (copy to .env — never commit .env)
DATABRICKS_HOST=adb-xxxx.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxx
DATABRICKS_TOKEN=dapixxxxxxxx

# Optional — defaults shown
DATABRICKS_CATALOG=main
DATABRICKS_MARTS_SCHEMA=football_marts
DATABRICKS_CORE_SCHEMA=football_core
DATABRICKS_OPS_SCHEMA=football_ops
