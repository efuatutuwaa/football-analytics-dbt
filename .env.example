# Copy to .env in the project root (never commit .env).
# Used by scripts/job_spike_check.py, scripts/dbt_alert.py, scripts/send_triage_report.py

# Databricks SQL warehouse (football workspace)
DATABRICKS_HOST=dbc-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxx
DATABRICKS_TOKEN=dapixxxxxxxx

# Gmail — generate app password at https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
TRIAGE_RECIPIENT_EMAIL=you@gmail.com

# Optional — GitHub issues for HIGH severity dbt failures (dbt_alert.py)
GITHUB_REPO=efuatutuwaa/football-analytics-dbt
